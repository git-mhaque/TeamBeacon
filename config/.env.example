JIRA_BASE_URL=https://your-jira-host.example.com
JIRA_PAT=replace-with-pat-token
JIRA_PROJECT_KEY=PROJECTKEY
JIRA_BOARD_ID=12345
JIRA_STORY_POINTS_FIELD=customfield_10016
JIRA_EPIC_LINK_FIELD=customfield_10902
JIRA_SPRINT_FIELDS=sprint,customfield_10901,customfield_10020
JIRA_AUTH_MODE=pat_bearer
# JIRA_USERNAME=firstname.lastname@example.com
# JIRA_TIMEOUT_SECONDS=30

# Confluence
CONFLUENCE_BASE_URL=https://your-confluence-host.example.com
CONFLUENCE_PAT=replace-with-confluence-pat-token
CONFLUENCE_AUTH_MODE=pat_bearer
# CONFLUENCE_USERNAME=firstname.lastname@example.com
# CONFLUENCE_TIMEOUT_SECONDS=30

# Active AI provider for TeamBeacon intelligence features.
# Supported values: oci, ollama, openai
INTELLIGENCE_PROVIDER=oci

# OCI GenAI (TeamBeacon AI features)
OCI_GENAI_COMPARTMENT_ID=ocid1.compartment.oc1..replace-with-compartment-ocid
OCI_GENAI_ENDPOINT=https://inference.generativeai.us-chicago-1.oci.oraclecloud.com
OCI_GENAI_MODEL_ID=cohere.command-r-08-2024
OCI_GENAI_CONFIG_PROFILE=DEFAULT
OCI_GENAI_CONFIG_FILE=~/.oci/config
OCI_GENAI_MAX_TOKENS=600
OCI_GENAI_TEMPERATURE=1
OCI_GENAI_TOP_P=0.75
OCI_GENAI_TOP_K=0
OCI_GENAI_FREQUENCY_PENALTY=0
OCI_GENAI_CONNECT_TIMEOUT_SECONDS=10
OCI_GENAI_READ_TIMEOUT_SECONDS=240

# Ollama (used when INTELLIGENCE_PROVIDER=ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e2b
OLLAMA_NUM_CTX=8192
OLLAMA_MAX_TOKENS=600
OLLAMA_TEMPERATURE=1
OLLAMA_TOP_P=0.75
OLLAMA_TOP_K=0
OLLAMA_REPEAT_PENALTY=1
OLLAMA_CONNECT_TIMEOUT_SECONDS=10
OLLAMA_READ_TIMEOUT_SECONDS=240

# OpenAI (used when INTELLIGENCE_PROVIDER=openai)
# OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=600
OPENAI_TEMPERATURE=1
OPENAI_TOP_P=0.75
OPENAI_FREQUENCY_PENALTY=0
OPENAI_CONNECT_TIMEOUT_SECONDS=10
OPENAI_READ_TIMEOUT_SECONDS=240

# Set to 1 when you intentionally run live integration tests.
RUN_LIVE_JIRA_TESTS=0
