{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TeamBeacon",
  "version": "0.1.0",
  "identifier": "com.teambeacon.desktop",
  "build": {
    "frontendDist": "../web",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:release"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TeamBeacon",
        "width": 1440,
        "height": 920,
        "minWidth": 1180,
        "minHeight": 760,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
