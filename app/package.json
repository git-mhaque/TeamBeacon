{
  "name": "teambeacon-ui-shell",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "clean:generated": "node -e \"const fs=require('fs');['vite.config.js','vite.config.d.ts','tsconfig.tsbuildinfo','tsconfig.node.tsbuildinfo'].forEach((f)=>fs.rmSync(f,{force:true}));\"",
    "predev": "npm run clean:generated",
    "prebuild": "npm run clean:generated",
    "predesktop:dev": "npm run clean:generated",
    "predesktop:build": "npm run clean:generated",
    "api:dev": "./scripts/run-api.sh",
    "dev:ui": "vite",
    "dev": "./scripts/dev-with-api.sh",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "desktop:dev": "./scripts/tauri-with-rust.sh dev",
    "desktop:build": "./scripts/tauri-with-rust.sh build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.1",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.10"
  }
}
