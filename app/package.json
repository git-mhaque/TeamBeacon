{
  "name": "teambeacon-ui",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "TeamBeacon React web frontend",
  "scripts": {
    "api:dev": "./scripts/run-api.sh",
    "dev:web": "vite --host 0.0.0.0 --port 5174",
    "dev": "./scripts/dev-with-api.sh",
    "build": "npm run typecheck && vite build",
    "build:release": "npm run build",
    "preview": "vite preview --host 0.0.0.0 --port 5174",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "chart.js": "4.5.1",
    "lucide-react": "1.28.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.2",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.8.0",
    "jsdom": "29.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.0",
    "vitest": "4.1.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
