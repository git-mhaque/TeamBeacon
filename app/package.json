{
  "name": "teambeacon-ui",
  "private": true,
  "version": "1.0.0",
  "description": "TeamBeacon Oracle JET desktop frontend",
  "scripts": {
    "api:dev": "./scripts/run-api.sh",
    "dev:web": "ojet serve web --server-port 5174 --server-only",
    "dev": "./scripts/dev-with-api.sh",
    "build": "ojet build web",
    "build:release": "ojet build web --release",
    "restore": "ojet restore",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "desktop:dev": "./scripts/tauri-with-rust.sh dev",
    "desktop:build": "./scripts/tauri-with-rust.sh build"
  },
  "dependencies": {
    "@oracle/oraclejet": "~20.0.0",
    "@oracle/oraclejet-core-pack": "~20.0.0"
  },
  "devDependencies": {
    "@oracle/ojet-cli": "~20.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/preact": "^3.2.4",
    "@vitest/coverage-v8": "^4.1.2",
    "extract-zip": "^1.7.0",
    "fs-extra": "^8.1.0",
    "glob": "10.4.5",
    "jsdom": "^29.0.1",
    "typescript": "5.8.3",
    "underscore": "^1.10.2",
    "vitest": "^4.0.18",
    "yargs-parser": "13.1.2"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "overrides": {
    "@types/minimatch": "5.1.2"
  }
}
